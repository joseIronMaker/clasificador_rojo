<?xml version="1.0" ?>
<!-- Robot "supervisor" de Webots (supervisor TRUE en el .wbt). Carga el plugin C++
     ControladorBanda, que controla la velocidad de la banda (/conveyor/enable) y el agarre
     por Supervisor (/agarre): teletransporta DEF BOX_ROJA para que siga al gripper (grip_frame)
     o al TurtleBot (tb_frame), leyendo sus poses por TF en world_frame.
     robot_name del WebotsController debe ser "robot_supervisor". -->
<robot name="robot_supervisor">
  <webots>
    <plugin type="clasificador_rojo::ControladorBanda">
      <belt_speed>0.25</belt_speed>
      <world_frame>world</world_frame>
      <grip_frame>tool0</grip_frame>
      <!-- ride_z: altura del CENTRO de la caja (cubo 0.12) sobre el origen del TurtleBot al viajar.
           0.20 -> base de la caja en ~0.14 (sobre el cuerpo del Burger ~0.19 alto), no se encaja. -->
      <ride_z>0.20</ride_z>
    </plugin>
  </webots>
  <link name="base_link"/>
</robot>
